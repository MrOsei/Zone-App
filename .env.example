# Local development keeps the SQLite database and uploaded avatars here.
# Render overrides this with /var/data/zone through render.yaml.
DATA_DIR=.data

# Optional: use a specific SQLite file instead of $DATA_DIR/zone.sqlite.
# DATABASE_PATH=/absolute/path/to/zone.sqlite

# The server listens on 0.0.0.0. Render supplies PORT automatically.
PORT=3000
